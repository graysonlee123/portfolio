---
import { PUBLIC_FORMSPREE_FORM_ID } from "astro:env/client";
import Heading from "./Heading.astro";
import Input from "./Input.astro";
import SubmitButton from "./SubmitButton.astro";
import TextArea from "./TextArea.astro";
---

<div>
  <Heading element="h2"> Contact </Heading>
  <p class="subheading">
    Looking to work together, or just want to say hello? I'm all ears.
  </p>
  <form
    action={`https://formspree.io/p/${PUBLIC_FORMSPREE_FORM_ID}/f/contact`}
    method="POST"
  >
    <div class="rows">
      <Input
        id="name"
        inputProps={{
          autocomplete: "given-name",
        }}
      >
        Name
      </Input>
      <Input
        id="email"
        required
        inputProps={{
          autocomplete: "email",
          type: "email",
        }}
      >
        Email
      </Input>
      <TextArea id="message" required inputProps={{ autocomplete: "off" }}>
        Message
      </TextArea>
      <div>
        <SubmitButton />
      </div>
    </div>
  </form>
</div>

<style>
  .subheading {
    margin-top: var(--spacing--sm);
  }

  .rows {
    margin-top: var(--spacing--md);
    display: grid;
    row-gap: 1.5rem;
  }
</style>

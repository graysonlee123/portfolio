---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"span">;

const props = Astro.props;
---

<!-- Style tag must precede the span — placing it after causes Astro to inject
     a whitespace text node between the component output and adjacent text,
     adding a spurious space before punctuation like commas. -->
<style>
  .span {
    color: hsl(var(--clr--prism--dark));

    transition-property: color;
    transition-duration: var(--duration--prism);
    transition-timing-function: var(--ease--prism);
  }
</style>

<span class="span" {...props}><slot /></span>
